{
  "name": "pet-tools",
  "productName": "Pet Tools",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel desktop pet for Windows",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.luneeest-lang.pettools",
    "productName": "Pet Tools",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "PetTools-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pet Tools"
    },
    "asarUnpack": [
      "node_modules/koffi/**"
    ]
  },
  "author": "luneeest-lang",
  "dependencies": {
    "koffi": "^3.3.8"
  }
}
